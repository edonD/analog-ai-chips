glassplan 1                       # <- v1 version token
plan bias_generator  from ..\..\vibrosense\00_bias\design.cir  grid 1mm

# Demo of EVERY GlassPlan v1 feature on the bias generator.
# Inline comments like this one are v1; so is the line continuation
# (backslash) used in the OTA group below.

mirror MIR1 = XM3 XM4 XM7
core5t OTA1 = pair(XMo1 XMo2) tail(XMo5) \
              loads(XMo3 XMo4) diode(XMo3)     # continued line (v1)
diode-link = XM1
lateral = XMsw

flow
  region "Beta-multiplier core" [XM1] [XM2 XR1a XR1b]
  region "PMOS mirror" MIR1
  region "Regulation OTA" OTA1 [XC_comp]
  region "Startup & protection" [XM6] [XC_gs XR_gs] [XMsw]

orient XM6  R180                  # full 8-orientation group (v1):
orient XMsw MX90                  # rotated AND mirrored switch
shift  XC_comp 2 0                # relative nudge, whole mm
place  XM6 138 57                 # ABSOLUTE coordinates (v1 escape hatch)

# Full pinned wire path (v1): the gs net drawn MY way, with a
# deliberate detour jog so you can see it is hand-specified.
# (Pins must be path VERTICES; with MX90 the switch gate sits at 180,40.)
wire gs path 162,19 156,19 156,36 162,36 162,53
wire gs path 180,40 180,36 162,36
